## preflight shell check
function zshonly(){
  ## only run command if this is an interactive login zsh
  ## (must return 0 when skipped — scripts source this file under `set -e`)
  local currshell
  currshell=$(ps -p $$ | grep $$ | awk '{ print $4 }')
  if [[ "${currshell}" = "-zsh" ]]; then
    "${@}"
  fi
}

## oh-my-zsh aliases to remove
zshonly disable r

## mac only aliases
if [[ $(uname) = "Darwin" ]]; then
    alias emacs='/Applications/Emacs.app/Contents/MacOS/Emacs "$@"'
    alias vim='nvim'
    alias flushdns='dscacheutil -flushcache;sudo killall -HUP mDNSResponder'
    alias restart_en0='sudo ifconfig en0 down && sudo ifconfig en0 up'
    alias sortlaunchpad='defaults write com.apple.dock ResetLaunchPad -bool true; killall Dock'
    alias brewdoc='brew update && brew doctor'
    alias brewup='brew update && brew doctor && brew upgrade && brew cleanup'
    alias brewforce='brew update && brew doctor; brew upgrade; brew cleanup'
    alias brewfix='brew update-reset'
    alias caskup='brew upgrade --cask && brew cleanup'
    alias caskall='brew upgrade --cask --greedy && brew cleanup'
    # double `mas outdated` + rehash avoids retrying already-upgraded apps (mas quirk)
    alias masup='mas outdated && mas outdated && rehash && mas upgrade'
    alias speedtest='networkQuality'
    alias genpass='pwgen -s -1 16 | tee >(pbcopy)'
    alias genuuid='uuidgen | tr "[:upper:]" "[:lower:]" | tee >(pbcopy)'
    ### stop correction intrusion
    zshonly alias npm='nocorrect npm'
    zshonly alias kubectl='nocorrect kubectl'

    ### mac development
    ### browser reloading
    alias livereload-safari="filewatcher '**/*' 'osascript ~/bin/reload-safari.scpt' &"
    alias livereload-chrome="filewatcher '**/*' 'osascript ~/bin/reload-chrome.scpt' &"
    ### node
    alias npmlist='npm list -g --depth=0 2>/dev/null'
    ### js
    alias chromedev='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222 &'
    ### ghostty
    alias ssh='TERM=xterm-256color /usr/bin/ssh'
    ### ai tools
    alias cursor='agent'
fi

## linux only aliases
if [[ $(uname) = "Linux" ]]; then
    alias vim='nvim'
fi

## update dot files
function update-dotfiles(){
    curdir=$(pwd)
    cd ~/dotfiles && git pull && sh deploy.sh
    cd $curdir
}

## fix emacs packages
function fix-emacs-pkgs(){
    rm -rf ~/.emacs.d/elpa/*
    rm -rf ~/.emacs.d/eln-cache/*
    rm -rf ~/.emacs.d/.cache/*
    rm -rf ~/.emacs.d/tree-sitter/*
}
function unfreeze-emacs(){
  kill -SIGUSR2 $(pgrep -fli emacs)
}

## when in a shell in emacs, remind yourself not to launch vim/nvim there
[[ $(uname) = "Darwin" ]] && [[ -n "${EMACS:-}" ]] && alias vim='echo "Do not run Vim/Neovim in a shell within Emacs; use Emacs to edit"'
[[ $(uname) = "Darwin" ]] && [[ -n "${EMACS:-}" ]] && alias nvim='echo "Do not run Vim/Neovim in a shell within Emacs; use Emacs to edit"'

## man page color and search hilighting
export PAGER="less"
function man(){
    env \
	LESS_TERMCAP_mb=$(printf "\e[1;31m") \
	LESS_TERMCAP_md=$(printf "\e[1;31m") \
	LESS_TERMCAP_me=$(printf "\e[0m") \
	LESS_TERMCAP_se=$(printf "\e[0m") \
	LESS_TERMCAP_so=$(printf "\e[1;44;33m") \
	LESS_TERMCAP_ue=$(printf "\e[0m") \
	LESS_TERMCAP_us=$(printf "\e[1;32m") \
	man "$@"
}
