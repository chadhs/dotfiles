## Homebrew Ruby gem bindir for the active brew ruby only.
# Do not `find` under lib/ruby/gems — that picks up stale 3.x trees and nested
# gem package bins, which shadow `ruby`/`gem`/`bundle` from Homebrew.
for ruby_bin in /opt/homebrew/opt/ruby/bin/ruby /usr/local/opt/ruby/bin/ruby; do
  if [ -x "${ruby_bin}" ]; then
    gem_user_bin="$("${ruby_bin}" -e 'print Gem.bindir' 2>/dev/null)" || true
    if [ -n "${gem_user_bin}" ] && [ -d "${gem_user_bin}" ]; then
      PATH="${gem_user_bin}:${PATH}"
    fi
    break
  fi
done
export PATH

umask 0002 # grant write permsion to group

## mac only path updates
if [[ $(uname) = "Darwin" ]]; then
  ### homebrew
  export HOMEBREW_CASK_OPTS="--appdir=/Applications"
  ### emacs lsp performance
  export LSP_USE_PLISTS=true
  ### python
  export WORKON_HOME=~/.virtualenvs
  export PROJECT_HOME=~/src
  source virtualenvwrapper_lazy.sh
  ### node
  export NVM_DIR="$HOME/.nvm"
  #### load the nvm script but don't run it; we'll use system node for cli tools like linters
  [[ -s "/usr/local/opt/nvm/nvm.sh" ]] && source /usr/local/opt/nvm/nvm.sh --no-use
  [[ -s "/opt/homebrew/opt/nvm/nvm.sh" ]] && source /opt/homebrew/opt/nvm/nvm.sh --no-use
  ### ruby
  export OVERMIND_SHELL=/bin/zsh
fi

### additional user ENVs
[[ -e ~/.user-env ]] && source ~/.user-env
