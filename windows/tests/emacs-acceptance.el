;;; emacs-acceptance.el --- Full deployed editor checks -*- lexical-binding: t -*-
;; Set DOTFILES_TEST_ROOT to the isolated directory used for package installation.
(require 'cl-lib)
(require 'subr-x)
(defvar cs/acceptance-root
  (file-name-as-directory (or (getenv "DOTFILES_TEST_ROOT")
                             (error "Set DOTFILES_TEST_ROOT to an isolated test directory"))))
(setq user-emacs-directory (expand-file-name "emacs/" cs/acceptance-root)
      package-user-dir (expand-file-name "elpa" user-emacs-directory)
      package-gnupghome-dir (expand-file-name "gnupg" package-user-dir))
(defvar cs/acceptance-repo
  (expand-file-name "../.." (file-name-directory (or load-file-name buffer-file-name))))
(load-file (expand-file-name "editors/emacs.el" cs/acceptance-repo))
(require 'lsp-mode)
(require 'flycheck)
;; --batch -Q -l loads after after-init-hook, unlike a normal init.el launch.
(global-flycheck-mode 1)

(defun cs/acceptance-check (condition message)
  (unless condition (error "%s" message))
  (message "PASS %s" message))

(defun cs/acceptance-wait (predicate seconds message)
  (let ((deadline (+ (float-time) seconds)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.1))
    (cs/acceptance-check (funcall predicate) message)))

(defun cs/acceptance-command (program &rest arguments)
  (with-temp-buffer
    (let ((status (apply #'process-file program nil t nil arguments)))
      (unless (eq status 0)
        (error "%s failed with %s: %s" program status (buffer-string)))
      (buffer-string))))

(defun cs/acceptance-write (name content)
  (let ((file (expand-file-name name default-directory)))
    (with-temp-file file (insert content))
    file))

(let* ((default-directory (expand-file-name "emacs project/" cs/acceptance-root))
       (lsp-enable-file-watchers nil)
       (lsp-enable-suggest-server-download nil)
       (lsp-enable-suggest-server-restart nil)
       (lsp-response-timeout 30)
       (lsp-enabled-clients '(ts-ls))
       (flycheck-check-syntax-automatically nil))
  (make-directory default-directory t)
  (cs/acceptance-command "git" "init" "--quiet")
  (cs/acceptance-write "package.json" "{\"private\":true,\"devDependencies\":{\"eslint\":\"*\",\"prettier\":\"*\"}}\n")
  (cs/acceptance-write "tsconfig.json" "{\"compilerOptions\":{\"strict\":true,\"noEmit\":true},\"include\":[\"*.ts\"]}\n")
  (cs/acceptance-write ".prettierrc.json" "{\"singleQuote\":true}\n")
  (cs/acceptance-write "eslint.config.cjs" "module.exports = [{files: [\"**/*.js\"], rules: {\"no-unused-vars\": \"error\"}}];\n")
  (let ((ts (cs/acceptance-write "example.ts" "export function greet(name: string): string { return `Hello ${name}`; }\nconst message: string = greet(\"Windows\");\nconst broken: number = \"wrong\";\n"))
        (js (cs/acceptance-write "example.js" "const unused = 1;\nconsole.log(\"Windows\");\n"))
        (tsx (cs/acceptance-write "example.tsx" "export const element = <div>Windows</div>;\n"))
        (markdown (cs/acceptance-write "example.md" "# Windows\n\nShared editor acceptance test.\n"))
        (org (cs/acceptance-write "example.org" "* TODO Verify Windows editors\nAn Org heading.\n")))
    (cs/acceptance-command "git" "add" "--" ".")
    (dolist (tool '("git" "rg" "fd" "node" "gpg"))
      (cs/acceptance-check (executable-find tool) (concat tool " is available to the editor")))
    (cs/acceptance-check (custom-theme-p 'solarized-dark) "shared Solarized dark theme loads")
    (cs/acceptance-check (custom-theme-p 'solarized-light) "shared Solarized light theme loads")
    (dolist (language (append '(javascript typescript tsx)
                             (when (fboundp 'treesit-ensure-installed) '(jsdoc))))
      (cs/acceptance-check (treesit-language-available-p language)
                           (format "%s native grammar loads" language)))
    (lsp-workspace-folders-add default-directory)
    (find-file ts)
    (cs/acceptance-check (eq major-mode 'typescript-ts-mode) "TypeScript selects its shared major mode")
    (with-temp-buffer
      (cs/typescript-mode)
      (yas-define-snippets 'typescript-mode
                           '(("dotfilescheck" "const ${1:answer} = 42;" "acceptance check")))
      (insert "dotfilescheck")
      (let ((yas-prompt-functions '(yas-no-prompt)))
        (cs/acceptance-check (and (yas-expand)
                                 (equal (buffer-string) "const answer = 42;"))
                             "inherited TypeScript snippets expand")))
    (lsp)
    (cs/acceptance-wait (lambda () (and (bound-and-true-p lsp-mode)
                                      (cl-some (lambda (workspace)
                                                 (eq (lsp--workspace-status workspace) 'initialized))
                                               (lsp-workspaces))))
                        60 "TypeScript language server initializes")
    (cs/acceptance-wait (lambda () (> (hash-table-count (lsp-diagnostics)) 0))
                        30 "TypeScript reports diagnostics")
    (goto-char (point-min))
    (forward-line 1)
    (search-forward "greet")
    (backward-char 2)
    (cs/acceptance-check (lsp-request "textDocument/definition" (lsp--text-document-position-params))
                         "TypeScript definition navigation")
    (cs/acceptance-check (lsp-request "textDocument/completion" (lsp--text-document-position-params))
                         "TypeScript completion request")
    (cs/acceptance-check (memq 'lsp-completion-at-point completion-at-point-functions)
                         "LSP completion integrates with Company")
    (cs/acceptance-check (bound-and-true-p prettier-js-mode) "project configuration enables Prettier")
    (prettier-js)
    (cs/acceptance-check (string-match-p "greet('Windows')" (buffer-string))
                         "Prettier formats TypeScript through the native npm launcher")
    (save-buffer)
    (find-file js)
    (cs/acceptance-check (eq major-mode 'js-ts-mode) "JavaScript selects its shared major mode")
    (cs/acceptance-check (bound-and-true-p flycheck-mode) "shared Flycheck mode enables for JavaScript")
    (flycheck-buffer)
    (cs/acceptance-wait (lambda () (not (flycheck-running-p))) 30 "ESLint check completes")
    (cs/acceptance-check (cl-some (lambda (item)
                                  (string-match-p "unused" (flycheck-error-message item)))
                                flycheck-current-errors)
                         "ESLint reports an unused JavaScript variable")
    (find-file tsx)
    (cs/acceptance-check (eq major-mode 'tsx-ts-mode) "TSX selects its shared major mode")
    (cs/acceptance-check (treesit-buffer-root-node) "TSX syntax parsing")
    (find-file markdown)
    (cs/acceptance-check (derived-mode-p 'markdown-mode) "Markdown editing")
    (find-file org)
    (cs/acceptance-check (derived-mode-p 'org-mode) "Org editing")
    (cs/acceptance-check (string-match-p "example.md" (cs/acceptance-command "rg" "--files"))
                         "project file search with ripgrep")
    (cs/acceptance-check (string-match-p "example.ts" (cs/acceptance-command "fd" "--type" "f" "example"))
                         "file discovery with fd")
    (require 'projectile)
    (cs/acceptance-check (file-equal-p (projectile-project-root) default-directory)
                         "project-root discovery with spaces in the path")
    (require 'magit)
    (magit-status default-directory)
    (cs/acceptance-check (derived-mode-p 'magit-status-mode) "Magit status opens")
    (cs/acceptance-check (string-match-p "DOTFILES_NATIVE_SHELL" (shell-command-to-string "echo DOTFILES_NATIVE_SHELL"))
                         "native shell command")
    (cs/terminal-new)
    (let* ((process (get-buffer-process (current-buffer)))
           (buffer (current-buffer)))
      (cs/acceptance-check (and process (process-live-p process)) "interactive PowerShell starts")
      (process-send-string process "Write-Output ('DOTFILES_' + 'INTERACTIVE_SHELL')\n")
      (cs/acceptance-wait (lambda () (with-current-buffer buffer
                                      (member "DOTFILES_INTERACTIVE_SHELL"
                                              (split-string (buffer-string) "[\r\n]+" t))))
                         15 "interactive PowerShell runs a command")
      (set-process-query-on-exit-flag process nil)
      (delete-process process)
      (kill-buffer buffer))
    (message "PASS full native Emacs acceptance checks")))

;;; emacs-acceptance.el ends here
