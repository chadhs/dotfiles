[Unit]
Description=Regenerate the Codex record when the agents panel refreshes the packaged agents
# The packaged updater rewrites every record file on each panel refresh
# (open, manual, or its own timer), and its 4s codex RPC timeout frequently
# loses the race, shipping codex.json with "Codex limits unavailable".
# Watching those writes and re-probing gives the Codex tab the same instant
# recovery the other tabs get.

[Path]
PathModified=%h/.local/state/omarchy/agents/usage/claude.json
PathModified=%h/.local/state/omarchy/agents/usage/codex.json
Unit=omarchy-codex-record.service

[Install]
WantedBy=default.target
