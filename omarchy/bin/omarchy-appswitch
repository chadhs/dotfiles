#!/bin/bash

# omarchy:summary=Cmd+Tab-style app switcher across ALL workspaces and monitors (MRU order)
# omarchy:args=<next|prev>
# omarchy:examples=omarchy-appswitch next | omarchy-appswitch prev
#
# Cmd+Tab semantics: the first press snapshots the window list; further presses
# while focus is unchanged keep stepping through that same snapshot (so
# SUPER+SHIFT+TAB walks backwards instead of oscillating). Focus changed by
# other means (a click) starts a fresh snapshot.

set -euo pipefail

dir="${1:-next}"
[[ "$dir" == "next" || "$dir" == "prev" ]] || { echo "Usage: omarchy-appswitch <next|prev>" >&2; exit 1; }

STATE_DIR="$HOME/.local/state/omarchy/appswitch"
STATE="$STATE_DIR/state.json"
mkdir -p "$STATE_DIR"

cur=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' 2>/dev/null) || cur=""

# Spatial tab order instead of MRU: monitors left-to-right, workspaces in id
# order, rows top-to-bottom, windows right-to-left within each row, then wrap
# back to the start. Rows are clustered with a 150px tolerance. Set
# ORDER_LTR=1 in the environment to flip rows to left-to-right.
mapfile -t fresh < <(hyprctl clients -j | jq -r --argjson mons "$(hyprctl monitors -j)" --argjson ltr "$([ "${ORDER_LTR:-0}" = "1" ] && echo true || echo false)" '
  ($mons | map({key: (.id | tostring), value: .x}) | from_entries) as $mx
  | map(select(.workspace.id >= 0))
  | sort_by($mx[(.monitor | tostring)], .workspace.id, .at[1], (.at[0] * -1))
  | reduce .[] as $w ({rows: [], prevG: "", prevY: -9999, row: 0};
      (($mx[($w.monitor | tostring)] | tostring) + ":" + ($w.workspace.id | tostring)) as $g
      | (if $g != .prevG or (($w.at[1] - .prevY) > 150) then .row + 1 else .row end) as $r
      | {rows: (.rows + [$w + {row: $r}]), prevG: $g, prevY: $w.at[1], row: $r})
  | .rows
  | sort_by($mx[(.monitor | tostring)], .workspace.id, .row, (if $ltr then .at[0] else (.at[0] * -1) end))
  | .[].address')

n=${#fresh[@]}
(( n > 1 )) || exit 0

list=()
pos=0
resume=0
if [[ -f "$STATE" && -n "$cur" ]] && [[ "$(jq -r '.last // empty' "$STATE" 2>/dev/null || true)" == "$cur" ]]; then
  mapfile -t stored < <(jq -r '.list[]?' "$STATE" 2>/dev/null || true)
  # Keep only windows that still exist.
  list=()
  for a in "${stored[@]}"; do
    for f in "${fresh[@]}"; do
      [[ "$a" == "$f" ]] && { list+=("$a"); break; }
    done
  done
  if (( ${#list[@]} > 1 )); then
    pos=$(jq -r '.pos // 0' "$STATE")
    (( pos < 0 )) && pos=0
    (( pos >= ${#list[@]} )) && pos=$(( ${#list[@]} - 1 ))
    resume=1
  fi
fi

if (( ! resume )); then
  list=("${fresh[@]}")
  pos=-1
  for i in "${!list[@]}"; do
    [[ "${list[$i]}" == "$cur" ]] && pos=$i
  done
  (( pos < 0 )) && pos=0
fi

if [[ "$dir" == "next" ]]; then
  pos=$(( (pos + 1) % ${#list[@]} ))
else
  pos=$(( (pos - 1 + ${#list[@]}) % ${#list[@]} ))
fi

target="${list[$pos]}"
jq -n --argjson list "$(printf '%s\n' "${list[@]}" | jq -R . | jq -s .)" \
      --argjson pos "$pos" --arg last "$target" \
      '{list: $list, pos: $pos, last: $last}' >"$STATE"

# focus follows the window to its workspace and monitor
hyprctl dispatch "hl.dsp.focus({ window = \"address:$target\" })" >/dev/null 2>&1 || true
