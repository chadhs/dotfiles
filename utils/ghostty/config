## My Config Options
# Use Solarized Light when your OS is in light mode,
# and Solarized Dark when it’s in dark mode
theme = "light:Iterm2 Solarized Light,dark:Iterm2 Solarized Dark"
#theme = "Builtin Solarized Dark"
font-family = "Menlo"
font-size = 14
# Number of columns (width in character cells)
window-width  = 128
# Number of rows    (height in character cells)
window-height =  84
keybind = shift+enter=text:\n

## Super/Command: Neovim vs zsh
# ⌘a unbound so nvim select-all receives <D-a> (not Ghostty select_all).
# ⌘c is performable: copy a terminal selection if one exists, otherwise
# pass through for visual copy in nvim.
# ⌘v stays Ghostty paste so zsh and nvim insert mode both get clipboard
# text (bracketed paste). Neovide uses Neovim's <D-v> map instead.
keybind = super+a=unbind
keybind = performable:super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

### window splitting
## Keybindings for splitting
## - use alt to not conflict with tmux and nvim using ctrl
keybind = alt+backslash=new_split:right
keybind = alt+minus=new_split:down

## Keybindings for moving between splits
## - use alt to not conflict with tmux and nvim using ctrl
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right
