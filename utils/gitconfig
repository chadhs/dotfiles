## default to asking the user if not configured below
[user]
useconfigonly = true
[core]
ignorecase = false
excludesfile = ~/.gitignore
hooksPath = ~/.config/git/hooks
[push]
default = simple
[pull]
rebase = false
[color]
ui = auto
[credential]
helper = osxkeychain

## per machine config
[include]
  path = ~/.gitconfig-local
