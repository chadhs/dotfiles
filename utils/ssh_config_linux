# linux fork of utils/ssh_config — keep shared settings in sync with the mac
# file; the only intended divergence is the colima Include (mac container tool).

ForwardAgent yes
KeepAlive yes
ServerAliveInterval 100

Host *
ControlPath /tmp/%%h-%%p-%%r

# add additional localized configuration to config.d/ssh_config
# add your identities to config.d/ssh_config using the following format
## Host *
## IdentityFile ~/.ssh/id_rsa

Include config.d/*

# blip-setup: multiplexed sessions so Blip's polling costs ~50 ms, not a handshake
Host 192.168.110.106
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ServerAliveInterval 30
